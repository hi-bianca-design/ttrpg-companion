{
  "expo": {
    "name": "Session Zero",
    "slug": "session-zero",
    "version": "1.0.0",
    "scheme": "session-zero",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.session-zero"
    }
  }
}
