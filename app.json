{
  "expo": {
    "name": "DnD Companion",
    "slug": "dnd-companion",
    "version": "1.0.0",
    "scheme": "dnd-companion",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.dnd-companion"
    }
  }
}
